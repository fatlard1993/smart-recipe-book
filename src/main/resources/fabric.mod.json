{
	"schemaVersion": 1,
	"id": "smart-recipe-book",
	"version": "${version}",
	"name": "Smart Recipe Book",
	"description": "An enhanced recipe book with auto-crafting of sub-components",
	"authors": ["justfatlard"],
	"contact": {
		"sources": "https://github.com/fatlard1993/smart-recipe-book"
	},
	"license": "MIT",
	"icon": "assets/smart-recipe-book/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": ["com.smartrecipe.server.BrewingRecipeSender", "com.smartrecipe.server.RecipeCatalogSender"],
		"client": ["com.smartrecipe.SmartRecipeBookMod"]
	},
	"mixins": ["smart-recipe-book.mixins.json"],
	"depends": {
		"fabricloader": ">=${loaderVersion}",
		"fabric-api": "${fabricApiVersion}",
		"minecraft": "${minecraftDependency}",
		"java": ">=25"
	},
	"suggests": {
		"pandorical": "*"
	}
}
